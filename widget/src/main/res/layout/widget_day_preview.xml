<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher's widget list shows (Android 12+): Shani's day in a calm hour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_planet_shani" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_planet_shani"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:background="@drawable/widget_dot_ring">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_dark_blue" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/widget_mood_calm"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
