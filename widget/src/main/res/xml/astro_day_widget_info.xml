<?xml version="1.0" encoding="utf-8"?>
<!-- One cell (1x1). It can be stretched, but the content stays the same small tile in the middle.
     No fixed update period: the widget sets its own alarm for the next planetary hour or midnight, whichever is
     first, so it changes when the mood or the day changes and not otherwise. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_day"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_day_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
