            {
              "en": "Dvisvabhava (dual)",
              "hi": ""
            }
          ],
          "answer": 1,
          "explanation": {
            "en": "They are the four chara (movable) signs, the starters. Each begins a new group of three in the zodiac.",
            "hi": ""
          }
        }
      ]
