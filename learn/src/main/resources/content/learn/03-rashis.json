  "lessons": [
    {
      "id": "rashis.what",
      "title": {
        "en": "What a rashi is",
        "hi": ""
      },
      "minutes": 4,
      "cards": [
        {
          "id": "rashis.what.1",
          "type": "learn",
          "title": {
            "en": "The twelve rashis",
            "hi": ""
          },
          "body": {
            "en": "A rashi (sign) is one twelfth of the zodiac: 30° of sky. Starting from Mesha at 0°, the twelve rashis run in order around the 360° wheel. In Jyotish they are measured against the fixed stars.",
            "hi": ""
          },
          "term": {
            "devanagari": "राशि",
            "roman": "Rashi"
          },
          "visual": {
            "kind": "zodiac",
            "value": 0
          }
        },
        {
          "id": "rashis.what.2",
          "type": "learn",
          "title": {
            "en": "The stage for the actors",
            "hi": ""
          },
          "body": {
            "en": "If the grahas are the actors, the rashis are the stage and the costumes. The same Mangal behaves differently in fiery Mesha than in watery Karka. A rashi colours how a graha expresses itself.",
            "hi": ""
          }
        },
        {
          "id": "rashis.what.3",
          "type": "learn",
          "title": {
            "en": "Four elements",
            "hi": ""
          },
          "body": {
            "en": "Each rashi has a tattva (element). Fire: Mesha, Simha, Dhanu. Earth: Vrishabha, Kanya, Makara. Air: Mithuna, Tula, Kumbha. Water: Karka, Vrishchika, Meena. The pattern repeats every four signs.",
            "hi": ""
          },
          "term": {
            "devanagari": "तत्त्व",
            "roman": "Tattva"
          },
          "visual": {
            "kind": "zodiac",
            "value": 0
          }
        },
        {
          "id": "rashis.what.4",
          "type": "learn",
          "title": {
            "en": "What the elements mean",
            "hi": ""
          },
          "body": {
            "en": "Fire is drive, spirit and courage. Earth is practical, steady and patient. Air is thought, talk and connection. Water is feeling, care and intuition. Every chart mixes all four in its own way.",
            "hi": ""
          }
        },
        {
          "id": "rashis.what.5",
          "type": "learn",
          "title": {
            "en": "Three qualities",
            "hi": ""
          },
          "body": {
            "en": "Each rashi also has a quality. Chara (movable): Mesha, Karka, Tula, Makara, quick to start. Sthira (fixed): Vrishabha, Simha, Vrishchika, Kumbha, steady. Dvisvabhava (dual): Mithuna, Kanya, Dhanu, Meena, flexible.",
            "hi": ""
          },
          "term": {
            "devanagari": "चर",
            "roman": "Chara"
          }
        },
        {
          "id": "rashis.what.6",
          "type": "learn",
          "title": {
            "en": "Odd and even signs",
            "hi": ""
          },
          "body": {
            "en": "The rashis alternate. Odd signs, like Mesha, Mithuna and Simha, are traditionally called masculine: active and outgoing. Even signs, like Vrishabha, Karka and Kanya, are feminine: receptive and steady. Both are equal halves of one whole.",
            "hi": ""
          }
        },
        {
          "id": "rashis.what.7",
          "type": "quiz",
          "question": {
            "en": "How many degrees does each rashi span?",
            "hi": ""
          },
          "options": [
