            "hi": ""
          }
        },
        {
          "id": "rashis.what.9",
          "type": "quiz",
          "question": {
            "en": "Which quality do Mesha, Karka, Tula and Makara share?",
            "hi": ""
          },
          "options": [
            {
              "en": "Sthira (fixed)",
              "hi": ""
            },
            {
              "en": "Chara (movable)",
              "hi": ""
