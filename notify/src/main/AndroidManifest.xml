<?xml version="1.0" encoding="utf-8"?>
<!-- The daily note (ADR 0010). WorkManager brings its own boot receiver; this one only follows clock changes. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ asks the user; the app asks only when they say yes to a daily note. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name=".ClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
